.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ------------------------------------------------------------------------------
# Generated Archives, Temp & Output Files
